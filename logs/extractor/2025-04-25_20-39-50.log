            event["description"].append(f"The event 'occurred' is the umbrella term for the 'killings' or 'murders' at the designated place and time.")
            event["description"].append(f"The event 'occurred' at {event['event_location']} on {event['event_time']}, referencing the entire sequence of actions.")


        events.append(event)
    return events
