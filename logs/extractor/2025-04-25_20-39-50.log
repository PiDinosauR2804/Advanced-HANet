def extract_events(text, trigger_words):
    """
    Extracts events from a text based on trigger words and generates descriptions.

    Args:
        text: The input text string.
        trigger_words: A list of trigger words.

    Returns:
        A list of dictionaries, where each dictionary represents an event.
    """

    events = []
    text_lower = text.lower()

    for trigger_word in trigger_words:
        event = {
            "trigger_word": trigger_word,
            "event_type": None,
            "event_time": None,
            "event_location": None,
            "event_participants": [],
            "description": []
        }

        # Event Type (Inferred from trigger word and context)
        if trigger_word in ["deaths"]:
            event["event_type"] = "death"
        elif trigger_word in ["used"]:
            event["event_type"] = "use"
        elif trigger_word in ["announced"]:
            event["event_type"] = "announcement"
        elif trigger_word in ["massacre"]:
            event["event_type"] = "massacre"
        elif trigger_word in ["resulted"]:
            event["event_type"] = "cause"
        elif trigger_word in ["executed"]:
            event["event_type"] = "execution"
        elif trigger_word in ["incidents"]:
            event["event_type"] = "occurrence"
        
        # Event Participants
        if trigger_word in ["deaths", "massacre", "executed"]:
            participants = []
            if "victims" in text_lower:
                 start_index = text_lower.find("victims") + len("victims")
                 end_index = text.find("had been")
                 if end_index == -1 : end_index = len(text)
                 if start_index < end_index:
                    phrase = text[start_index:end_index].strip(" ;,.'")
                    if phrase : participants = ["victims"]
            event["event_participants"] = participants

        # Event Location
        if trigger_word in ["used"]:
            if "against taldou" in text_lower:
                event["event_location"] = "taldou"

        # Descriptions
        if trigger_word == "deaths":
            event["description"].extend([
                "The trigger word 'deaths' signifies the loss of life.",
                "The event 'deaths' in this context relates to a small proportion that appeared to have resulted from artillery.",
                "The sentence suggests that deaths resulted from artillery and tank rounds used."
            ])
        elif trigger_word == "used":
            event["description"].extend([
                "The trigger word 'used' indicates the application of something.",
                "The event 'used' in this context indicates the application of artillery and tank rounds.",
                "Artillery and tank rounds were used against a specific location, taldou."
            ])
        elif trigger_word == "announced":
            event["description"].extend([
                "The trigger word 'announced' suggests a formal declaration of information.",
                "The event 'announced' refers to the U.N.'s later release of information.",
                "The U.N. announced information about the massacre."
            ])
        elif trigger_word == "massacre":
            event["description"].extend([
                "The trigger word 'massacre' refers to the act of killing many people.",
                "The event 'massacre' describes a particularly cruel event resulting in many deaths.",
                "The sentence states that most of the victims of the massacre had been executed."
            ])
        elif trigger_word == "resulted":
            event["description"].extend([
                "The trigger word 'resulted' indicates a cause-and-effect relationship.",
                "The event 'resulted' implies that deaths happened because of artillery and tank rounds.",
                "The deaths resulted from the use of artillery and tank rounds."
            ])
        elif trigger_word == "executed":
            event["description"].extend([
                "The trigger word 'executed' means that a person was killed as a punishment.",
                "The event 'executed' clarifies how the victims of the massacre died.",
                "The victims were summarily executed in two separate incidents."
            ])
        elif trigger_word == "incidents":
            event["description"].extend([
                "The trigger word 'incidents' refers to specific occurrences or events.",
                "The event 'incidents' refers to the context that the victims had been executed in two separate incidents.",
                "The execution of the massacre's victims took place in two separate incidents."
            ])

        events.append(event)

    return events
