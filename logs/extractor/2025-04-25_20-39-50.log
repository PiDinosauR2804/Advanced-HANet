            event["description"] = [
                f"The trigger word 'shot' indicates the use of a firearm to injure or kill someone.",
                f"The event 'shot' implies a violent act where projectiles were fired at {event['event_participants']}.",
                f"The event of being 'shot' occurred on {event['event_time']} at {event['event_location']}."
            ]

        elif trigger_word == "dead":
            event["event_type"] = "death"
            event["event_time"] = "24 march 1922"
            event["event_location"] = "the home of the mcmahon family in belfast, northern ireland"
            event["event_participants"] = ["six catholic civilians"]
            event["description"] = [
