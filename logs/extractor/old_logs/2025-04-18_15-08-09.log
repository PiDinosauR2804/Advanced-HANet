def extract_events(text):
    """
    Extracts events from the text.

    Args:
        text: The input text.

    Returns:
        A list of event dictionaries.
    """
    events = []
    # Event 1
    if "decide" in text.lower():
        event = {
            "event_type": "decision_making",
            "trigger_word": "decide",
            "event_time": None,
            "event_location": None,
            "event_participants": None,
            "description": "The trigger word decide refers to the process of making a choice or coming to a conclusion."
        }
        events.append(event)

    # Event 2
    if "know" in text.lower():
        event = {
            "event_type": "knowledge_acquisition",
            "trigger_word": "know",
            "event_time": None,
            "event_location": None,
            "event_participants": None,
            "description": "The trigger word know refers to the state of having information or understanding about something."
        }
        events.append(event)

    return events

