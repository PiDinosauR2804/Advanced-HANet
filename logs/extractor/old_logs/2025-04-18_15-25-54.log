            "event_location": None,
            "event_participants": ["Suharto"],
            "description": "The trigger word 'fallen' signifies the loss of power or authority by the dictator Suharto."
        }
        events.append(event)

    # Event 2: "changed"
    if "changed" in text:
        event = {
            "event_type": "political_change",
            "trigger_word": "changed",
            "event_time": None,
            "event_location": None,
            "event_participants": None,
