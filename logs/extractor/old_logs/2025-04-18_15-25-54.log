            "trigger_word": "unshackled",
            "event_time": None,
            "event_location": None,
            "event_participants": ["media"],
            "description": "The trigger word 'unshackled' signifies liberation or setting free the media."
        }
        events.append(event)

    # Event 4: "held"
    if "held" in text:
        event = {
            "event_type": "election",
            "trigger_word": "held",
            "event_time": None,
            "event_location": None,
            "event_participants": None,
            "description": "The trigger word 'held' indicates the occurrence of democratic elections."
        }
        events.append(event)
        
    # Event 5: "freed"
    if "freed" in text:
        event = {
            "event_type": "liberation",
            "trigger_word": "freed",
            "event_time": None,
            "event_location": "east timor",
            "event_participants": None,
            "description": "The trigger word 'freed' signifies setting free east timor."
        }
        events.append(event)

    return events

