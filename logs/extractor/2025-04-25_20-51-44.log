def extract_event_information(text, trigger_words):
    """
    Extracts event information from a sentence given a list of trigger words.

    Args:
        text: The input sentence.
        trigger_words: A list of trigger words in the sentence.

    Returns:
        A list of dictionaries, where each dictionary represents an event.
    """

    events = []
    for trigger_word in trigger_words:
        event = {
            "trigger_word": trigger_word,
            "event_type": None,
            "event_time": None,
            "event_location": None,
            "event_participants": None,
            "description": []
        }

        if trigger_word in ["killings", "murders"]:
            event["event_type"] = "killing"  # Assuming "killings" and "murders" implies a killing event.
            event["event_time"] = "24 march 1922"
            event["event_location"] = "belfast , northern ireland"
            event["event_participants"] = ["six catholic civilians", "the mcmahon family"] # victim and location of killing, hard to assign perpetrators, and more context needed

            event["description"].extend([
                f"The trigger word '{trigger_word}' signifies a violent act resulting in death.",
                f"The event described involves the killing of individuals, specifically six catholic civilians, during a specific timeframe and geographical location.",
                f"The use of '{trigger_word}' highlights an intentional act of taking a life, characterized by the details of location and time provided."
            ])


        elif trigger_word == "shot":
            event["event_type"] = "shooting"  # Based on trigger word "shot"
            event["event_time"] = "24 march 1922"
            event["event_location"] = "the home of the mcmahon family in belfast , northern ireland"
            event["event_participants"] = ["six catholic civilians"] # victims

            event["description"].extend([
                "The trigger word 'shot' refers to the act of firing a weapon at someone.",
                "The event is a shooting incident where victims were shot at a specific location and time.",
                "The term 'shot' illustrates the use of firearms as the method of causing death to the victims."
            ])


        elif trigger_word == "dead":
            event["event_type"] = "death"  # Implies a death event.
            event["event_time"] = "24 march 1922"
            event["event_location"] = "the home of the mcmahon family in belfast , northern ireland"
            event["event_participants"] = ["six catholic civilians"]  # implied victims

            event["description"].extend([
                "The word 'dead' indicates that a death event occurred.",
                "This event is characterized by the loss of life of several civilians at a specific location and time.",
                "The term 'dead' serves as a direct indicator of a fatal outcome in this event."
            ])

        elif trigger_word == "occurred":
            event["event_type"] = "occurrence"  # generic term, represents an incident
            event["event_time"] = "24 march 1922"
            event["event_location"] = "belfast , northern ireland"
            event["event_participants"] = ["six catholic civilians"] # can derive from context

            event["description"].extend([
                "The trigger word 'occurred' indicates that something happened at a given time and location.",
                "The event that 'occurred' is related to the 'killings' and 'murders', referring to a significant incident in the past.",
                "The use of 'occurred' provides a temporal reference to the events and establishes its place in history."
            ])

        events.append(event)

    return events
